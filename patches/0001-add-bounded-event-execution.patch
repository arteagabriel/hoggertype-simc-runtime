+double stats_t::iteration_actual_amount() const
+{
+  double amount = 0.0;
+
+  range::for_each( direct_results, [ &amount ]( const stats_results_t& result ) {
+    amount += result.iteration_actual_amount;
+  } );
+  range::for_each( tick_results, [ &amount ]( const stats_results_t& result ) {
+    amount += result.iteration_actual_amount;
+  } );
+
+  return amount;
+}
